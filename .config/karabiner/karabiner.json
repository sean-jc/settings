            "complex_modifications": {
                "rules": [
                    {
                        "description": "cmus on Velo Commands",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "volume_decrement",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "shell_command": "/usr/local/bin/ssh v 'amixer-volume-up-down down'" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "volume_increment",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "shell_command": "/usr/local/bin/ssh v 'amixer-volume-up-down up'" }],
                                "type": "basic"
                            },
                            {
                                "from": { "consumer_key_code": "play_or_pause" },
                                "to": [{ "shell_command": "/usr/local/bin/ssh v 'cmus-remote -u'" }],
                                "type": "basic"
                            },
                            {
                                "from": { "consumer_key_code": "scan_previous_track" },
                                "to": [{ "shell_command": "/usr/local/bin/ssh v 'cmus-remote -r'" }],
                                "type": "basic"
                            },
                            {
                                "from": { "consumer_key_code": "scan_next_track" },
                                "to": [{ "shell_command": "/usr/local/bin/ssh v 'cmus-remote -n'" }],
                                "type": "basic"
                            }
                        ]
                    },
