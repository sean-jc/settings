#!/bin/bash
dir=$(pwd)
if [[ $# -eq 1 ]]; then
	target=$1
elif [[ $HOSTPOST == "x1" ||  $HOSTPOST == "mbp" ]]; then
	target="z"
else
	printf "Must specify the target\n"
	exit 1
fi
if [[ $HOSTPOST == "x1" ]]; then
	dir="${dir/\/home\/seanjc/\~}"
elif [[ $HOSTPOST == "mbp" ]]; then
	dir="${dir/\/Users\/seanjc/\~}"
fi
git reset --hard HEAD
ssh $target "cd $dir ; git diff --no-prefix" | patch -p0 -r /dev/null --no-backup-if-mismatch
