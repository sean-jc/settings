#!/bin/bash
dir=$(pwd)
if [[ $# -eq 1 ]]; then
	target=$1
elif [[ $HOSTPOST == "x1" ||  $HOSTPOST == "mbp" ]]; then
	target="z"
else
	printf "Must specify the target, no default for $HOSTNAME\n"
	exit 1
fi
if [[ $HOSTPOST == "x1" ]]; then
	dir="${dir/\/home\/seanjc/\~}"
elif [[ $HOSTPOST == "mbp" ]]; then
	dir="${dir/\/Users\/seanjc/\~}"
fi
git diff --no-prefix | ssh $target "cd $dir ; git reset --hard HEAD ; patch -p0 -r /dev/null --no-backup-if-mismatch"
