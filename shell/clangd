function gen-clangd-commands() {
	local repo=$(pwd | rev | cut -d'/' -f1 | rev)

	if [[ ! -f ./scripts/clang-tools/gen_compile_commands.py ]]; then
		printf "Needs to be run from top-level directory of kernel repo\n"
		return 1
	fi
	if [[ $repo != "slf" && ! -d $HOME/build/kernel/clangd_$repo ]]; then
		printf "Target build directory '$HOME/build/kernel/clangd_$repo doesn't exist\n"
		return 1
	fi

	mkdir -p .vscode
	rm -f ./.vscode/compile_commands.json
	if [[ $repo != "slf" ]]; then
		./scripts/clang-tools/gen_compile_commands.py -d $HOME/build/kernel/clangd_$repo -o ./.vscode/compile_commands.json
		return 0
	fi

	local cmd

	echo "[" >> ./.vscode/compile_commands.json
	while read -r cmd; do
		local file

		echo "$cmd" | grep -q -E "^make:"
		if [[ $? -eq 0 ]]; then
			continue
		fi

		file=$(echo $cmd | grep -oP '(?<=\-c\s)\S+')
		if [[ $? -ne 0 ]]; then
			continue
		fi

		echo " {" >> ./.vscode/compile_commands.json
		echo "  \"command\": \"$cmd\"," >> ./.vscode/compile_commands.json
		echo "  \"directory\": \"$HOME/go/src/kernel.org/slf/tools/testing/selftests/kvm\"," >> ./.vscode/compile_commands.json
		echo "  \"file\": \"$HOME/go/src/kernel.org/slf/tools/testing/selftests/kvm/$file\""  >> ./.vscode/compile_commands.json
		echo " }," >> ./.vscode/compile_commands.json
	done <<< $(LLVM=1 make -C tools/testing/selftests/kvm -Bnwk)

	# Strip the last comma, JSON doesn't allow trailing commas
	sed -i '$ s/.$//' .vscode/compile_commands.json
	echo "]" >>./.vscode/compile_commands.json
}
alias ccm='gen-clangd-commands'

function sync-compile-commands() {
	local repo=$(pwd | rev | cut -d'/' -f1 | rev)

	if [[ ! -f ./scripts/clang-tools/gen_compile_commands.py ]]; then
		printf "Needs to be run from top-level directory of kernel repo\n"
		return 1
	fi
	if [[ $repo != "slf" && ! -d $HOME/build/kernel/clangd_$repo ]]; then
		printf "Target build directory '$HOME/build/kernel/clangd_$repo doesn't exist\n"
		return 1
	fi
	mkdir -p .vscode
	rm -f ./.vscode/compile_commands.json
	scp z:/usr/local/google/home/seanjc/go/src/kernel.org/linux/.vscode/compile_commands.json ./.vscode/compile_commands.json
	if is-mac; then
		sed -n 's|.*"file": *"/usr/local/google/home/seanjc/build/kernel/clangd_linux/\([^"]*\)".*|\1|p' ./.vscode/compile_commands.json | sort -u | \
			rsync -av --files-from=- z:/usr/local/google/home/seanjc/build/kernel/clangd_linux/ /Users/seanjc/build/kernel/clangd_linux/
		rsync -rptv --include='*/' --include='*.h' --exclude='*' z:/usr/local/google/home/seanjc/build/kernel/clangd_linux/ /Users/seanjc/build/kernel/clangd_linux
		sed -i '' 's|/usr/local/google/home|/Users|g' ./.vscode/compile_commands.json
	else
		sed -n 's|.*"file": *"/usr/local/google/home/seanjc/build/kernel/clangd_linux/\([^"]*\)".*|\1|p' ./.vscode/compile_commands.json | sort -u | \
			rsync -av --files-from=- z:/usr/local/google/home/seanjc/build/kernel/clangd_linux/ /home/seanjc/build/kernel/clangd_linux/
		rsync -rptv --include='*/' --include='*.h' --exclude='*' z:/usr/local/google/home/seanjc/build/kernel/clangd_linux/ /home/seanjc/build/kernel/clangd_linux
		sed -i '' 's|/usr/local/google/home|/home|g' ./.vscode/compile_commands.json
	fi
}