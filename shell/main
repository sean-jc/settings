# Refresh bash terminal
function refresh-shell() {
	if [ -n "$BASH_VERSION" ]; then
		source "$HOME/.bashrc"
	elif [ -n "$ZSH_VERSION" ]; then
		source "$HOME/.zshrc"
	else
		return 1
	fi
}
alias rf='refresh-shell'

alias sk='sudo -sE'

alias gcm='gcert -s -m kernel-development,corevirt-team-testing,platforms-regression --nossh_on_security_key && ssh-add $HOME/.ssh/id_local'

alias r=reup
alias k=kapwing
alias mf='make -j$(get-nr-cpus)'
alias mfc='make clean && make -j$(get-nr-cpus)'

alias vi='vim'

function curl-time()
{
	curl -4 -w "@$SETTINGS/bin/curl-format.txt" -o /dev/null -s $@
}
alias curlt='curl-time'

# temporary workaround
alias vscode='code --enable-features=UseOzonePlatform --ozone-platform=wayland &'

function meld-si-ti() {
	meld sinux/$1 tinux/$1
}
function meld-ti-si() {
	meld tinux/$1 sinux/$1
}
alias mi='meld-ti-si'

