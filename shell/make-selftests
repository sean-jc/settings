function configure-musl() {
	CC=clang AR=/usr/bin/llvm-ar RANLIB=/usr/bin/llvm-ranlib ./configure --prefix=$HOME/build/musl --disable-shared make -j128 && make install

	clang -c -x c /dev/null -o $HOME/build/musl/lib/crtbeginT.o
	cp $HOME/seanjc/build/musl/lib/crtbeginT.o $HOME/seanjc/build/musl/lib/crtbegin.o
	cp $HOME/seanjc/build/musl/lib/crtbeginT.o $HOME/seanjc/build/musl/lib/crtend.o
	llvm-ar rcs $HOME/seanjc/build/musl/lib/libgcc.a
	llvm-ar rcs $HOME/seanjc/build/musl/lib/libgcc_eh.a
}