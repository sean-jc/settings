function make-selftests() {
	local arch_dir
	local ldflags=""
	local tests
	local i
	local selftest
	local static=""
	local sysroot=""
	local ls
	local source=$HOME/go/src/kernel.org/$2/tools/testing/selftests/kvm
	local target=$HOME/build/tests/$3
	local output=$HOME/build/selftests/$3
	local command
	local ret

	if [[ $# -lt 2 ]] || [[ ! -d $source ]]; then
		printf "Must specify kernel directory as second argument\n"
		return 1
	fi
	if [[ $# -lt 3 ]] || [[ ! -d $output ]]; then
		printf "Must specify output directory as third argument\n"
		return 1
	fi
	if [[ $# -lt 3 ||$# -gt 4 ]]; then
		printf "Min of 3, max of 4 arguments supported\n"
	fi
	if [[ $# -gt 3 && $4 != "clean" ]]; then
		printf "Can only specify 'clean' as third argument\n"
		return 1
	fi

	if [[ $1 == "arm" ]]; then
		arch_dir="arm64"
	elif [[ $1 == "loong" ]]; then
		arch_dir="loongarch"
	elif [[ $1 == "ppc" ]]; then
		arch_dir="powerpc"
	else
		arch_dir=$1
	fi

	# Check for the old directories.
	if [[ ! -d $source/lib/$arch_dir ]]; then
		if [[ $1 == "x86" ]]; then
			arch_dir="x86_64"
		elif [[ $1 == "arm" ]]; then
			arch_dir="aarch64"
		elif [[ $1 == "s390" ]]; then
			arch_dir="s390x"
		fi
		if [[ ! -d $source/lib/$arch_dir ]]; then
			printf "Invalid arch '$arch_dir'?\n"
			return 1
		fi
	fi

	if is-mac; then
		sysroot="--sysroot=$HOME/build/musl"
		ldflags="--ld-path=/opt/homebrew/opt/lld/bin/ld.lld"
	fi

	pushd $HOME/go/src/kernel.org/$2
	if is-mac; then
		ln -sf $(which unifdef) $output/scripts
		ARCH=x86_64 make O=$output headers_install hostprogs= hostprogs-always-y= if_changed_dep='$(if_changed)' -j$(get-nr-cpus)
	else
		make-$1 make O=$output headers_install -j$(get-nr-cpus)
	fi

	ret=$?
	if [[ $? -ne 0 ]]; then
		return ret
	fi

	cd $HOME/go/src/kernel.org/$2/tools/testing/selftests/kvm
	if [[ $# -gt 3 && $4 == "clean" ]]; then
		make-$1 make OUTPUT=$output clean -j$(get-nr-cpus)
	fi

	# Statically linking on s390 fails due to duplicate memset/memcmp
	# definitions.  s390 is only ever compile-tested only, i.e. statically
	# linking isn't necessary, so just paper over the problem.
	if [[ $(whoami) == "seanjc" && $1 != "s390" ]]; then
		static="-static"
	fi
	if [[ $1 == "riscv" ]]; then
		static="$static -Wno-duplicate-decl-specifier"
	fi

	if [[ -d "runner" ]]; then
		command="testcases"
	else
		command="install"
	fi

	KHDR_INCLUDES="-isystem $output/usr/include" EXTRA_CFLAGS="$static $sysroot -Werror -gdwarf-4" make-$1 make USERLDFLAGS="$ldflags" INSTALL_HDR_PATH="$output/usr" OUTPUT=$output DEFAULT_TESTCASES=testcases INSTALL_PATH=$target -j$(get-nr-cpus) $command

	ret=$?
	if [[ $? -eq 0 ]]; then
		rm -f $target/config
		rm -f $target/settings
	fi
	popd
	return $ret
}

alias jt='make-clang   make-selftests x86 slf c'
alias jtc='make-clang  make-selftests x86 slf c clean'
alias jti='make-clang  make-selftests x86 tinux ti_c'
alias jtic='make-clang make-selftests x86 tinux ti_c clean'

if is-mac; then
	alias mt='jt'
	alias mtc='jtc'
	alias mti='jti'
	alias mtic='jtic'
else
	alias mt='make-selftests   x86 slf x86'
	alias mtc='make-selftests  x86 slf x86 clean'
	alias mti='make-selftests  x86 tinux ti'
	alias mtic='make-selftests x86 tinux ti clean'
fi

